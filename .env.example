# ---- Required ----
GOOGLE_API_KEY=replace-me
GOOGLE_GENAI_USE_VERTEXAI=False
SERPAPI_API_KEY=replace-me
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
OPENLIBRARY_CONTACT=your.email@example.com

# ---- Models ----
AGENT_MODEL=gemini-3.1-flash-lite
VISION_MODEL=gemini-3.5-flash-lite
# Optional legacy setting; unused by the browser speech cascade.
# LIVE_MODEL=gemini-3.8-live
# Optional stretch: independent checker model
CHECKER_MODEL=

# ---- Optional ----
GOOGLE_BOOKS_API_KEY=
SHOPPING_PROVIDER=serpapi
USED_PROVIDER=serpapi_ebay

# ---- Geometry ----
# modal | local | off   (off = room fields empty + review; spine dims via marker plane only)
GEOMETRY_BACKEND=modal
# mapanything | vggt
RECON_MODEL=mapanything
DEBUG_GEOMETRY=0

# ---- Scale cards (measure your printout with a ruler!) ----
MARKER_DICT=DICT_4X4_50
MARKER_SIZE_MM=100.0

# ---- Capture ----
HIRES_FPS=2
HIRES_WIDTH=1920
DEFAULT_COUNTRY=IN

# ---- Paths / misc ----
SWEEPS_DIR=./sweeps
CACHE_DB=./cache/http_cache.sqlite
LOG_LEVEL=INFO
